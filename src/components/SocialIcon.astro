---
type Props = {
  name: string
}

const { name } = Astro.props
const iconName = name.toLowerCase()
---

<svg
  class="social-icon"
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
  {
    iconName === "github" ? (
      <path
        fill="currentColor"
        d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.83a9.5 9.5 0 0 1 2.5.34c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85V21c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
      />
    ) : iconName === "email" ? (
      <g
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.75"
      >
        <rect x="3" y="5.5" width="18" height="13" rx="2" />
        <path d="m4.5 7 7.5 5.5L19.5 7" />
      </g>
    ) : iconName === "linkedin" ? (
      <path
        fill="currentColor"
        d="M5.1 7.8A1.8 1.8 0 1 0 5.1 4a1.8 1.8 0 0 0 0 3.8ZM3.6 20h3V9h-3v11Zm5.2 0h3v-5.45c0-1.44.27-2.83 2.06-2.83 1.76 0 1.78 1.65 1.78 2.93V20h3v-6.03c0-2.96-.64-5.24-4.1-5.24-1.66 0-2.77.91-3.22 1.77h-.04V9H8.8v11Z"
      />
    ) : iconName === "x" ? (
      <path
        fill="currentColor"
        d="M4.4 4h4.2l4.25 5.68L17.8 4h1.8l-5.9 6.98L20.45 20h-4.2l-4.7-6.28L6.25 20h-1.8l6.25-7.58L4.4 4Zm3.3 1.4 9.25 13.2h1.8L9.5 5.4H7.7Z"
      />
    ) : iconName === "dev.to" ? (
      <g
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.6"
      >
        <rect x="2.5" y="5.25" width="19" height="13.5" rx="2" />
        <path d="M6 9v6h1.2c1 0 1.8-.8 1.8-1.8v-2.4C9 9.8 8.2 9 7.2 9H6Zm5.25 0v6H14m-2.75-3H14m2-3 1.5 6L19 9" />
      </g>
    ) : iconName === "medium" ? (
      <g fill="currentColor">
        <ellipse cx="7" cy="12" rx="4.5" ry="6.5" />
        <ellipse cx="15.25" cy="12" rx="2.2" ry="6.5" />
        <ellipse cx="20" cy="12" rx="1" ry="5.75" />
      </g>
    ) : (
      <g
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.75"
      >
        <path d="M10 13.5a4.5 4.5 0 0 0 6.36 0l2.14-2.14A4.5 4.5 0 0 0 12.14 5L11 6.14" />
        <path d="M14 10.5a4.5 4.5 0 0 0-6.36 0L5.5 12.64A4.5 4.5 0 0 0 11.86 19L13 17.86" />
      </g>
    )
  }
</svg>
