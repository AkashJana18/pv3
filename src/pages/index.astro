---
import { Picture } from "astro:assets"

import portraitImage from "@/assets/formal-me.jpg"
import ContributionGraph from "@/components/ContributionGraph.astro"
import SocialIcon from "@/components/SocialIcon.astro"
import { siteConfig } from "@/config/site"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { loadPortfolioData } from "@/lib/data"
import { getStructuredData } from "@/lib/structured-data"

const SIX_HOURS = 60 * 60 * 6
const ONE_DAY = 60 * 60 * 24

Astro.response.headers.set(
  "Cache-Control",
  `public, max-age=0, s-maxage=${SIX_HOURS}, stale-while-revalidate=${ONE_DAY}`
)

const { github, writings } = await loadPortfolioData()
const structuredData = getStructuredData({
  projects: github.projects,
  articles: writings.articles,
})
const githubUrl = `https://github.com/${siteConfig.person.githubUsername}`
const articleDate = new Intl.DateTimeFormat("en-GB", {
  day: "2-digit",
  month: "2-digit",
  year: "2-digit",
})
const statusTime = new Intl.DateTimeFormat("en-IN", {
  timeZone: siteConfig.person.timeZone,
  hour: "2-digit",
  minute: "2-digit",
  hour12: true,
})
const formatStatusTime = (date: Date) =>
  statusTime
    .format(date)
    .replace(/\b(am|pm)\b/gi, (period) => period.toUpperCase())
---

<BaseLayout structuredData={structuredData}>
  <main id="content" class="portfolio-shell">
    <div class="portfolio-grid">
      <div class="profile-composition">
        <header class="intro" aria-labelledby="page-title">
          <h1 id="page-title">{siteConfig.person.givenName}</h1>
          <p class="role">{siteConfig.person.role}</p>
          <p class="status-line">
            <time
              id="india-clock"
              data-time-zone={siteConfig.person.timeZone}
              datetime={new Date().toISOString()}
            >
              {formatStatusTime(new Date())}
            </time>
            <span>{`, ${siteConfig.person.location}`}</span>
            <span
              id="weather-status"
              class="weather-status"
              data-latitude={siteConfig.person.weather.latitude}
              data-longitude={siteConfig.person.weather.longitude}
              aria-label="Weather loading; data by Open-Meteo"
              title="Weather data by Open-Meteo"
              aria-live="polite"
            >
              <span aria-hidden="true">,</span>
              <span class="weather-copy">--°C</span>
              <span class="weather-icon" aria-hidden="true">🌤️</span>
            </span>
          </p>
        </header>

        <figure class="portrait">
          <Picture
            src={portraitImage}
            alt={`Akash Jana outdoors in front of green foliage`}
            width={720}
            height={900}
            widths={[320, 480, 640, 720]}
            sizes="(min-width: 900px) 24rem, 100vw"
            layout="constrained"
            fit="cover"
            position="54% 50%"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality="mid"
            priority
            onerror="this.onerror=null;this.parentElement?.querySelectorAll('source').forEach((source)=>source.remove());this.srcset='';this.src='/formal-me.jpg'"
          />
        </figure>

        <div class="profile-notes">
          <section
            class="summary section-block"
            aria-labelledby="summary-title"
          >
            <h2 id="summary-title">Summary</h2>
            <div class="prose-stack">
              {
                siteConfig.summary.map((line) => (
                  <p>
                    {line.map((part) => {
                      if ("href" in part && part.href) {
                        return (
                          <a
                            href={part.href}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {part.emphasis ? (
                              <strong>{part.text}</strong>
                            ) : (
                              part.text
                            )}
                            <span aria-hidden="true"> ↗</span>
                          </a>
                        )
                      }

                      return part.emphasis ? (
                        <strong>{part.text}</strong>
                      ) : (
                        part.text
                      )
                    })}
                  </p>
                ))
              }
            </div>
            <p class="availability">
              Open to full-stack engineering opportunities, including Rust and
              Solana-focused work.
            </p>
          </section>
        </div>
      </div>

      <section class="activity section-block" aria-labelledby="activity-title">
        <h2 id="activity-title">GitHub activity</h2>
        <ContributionGraph
          calendar={github.calendar}
          source={github.source}
          profileUrl={githubUrl}
        />

        {
          github.pullRequests.length > 0 && (
            <div class="subsection">
              <ul class="compact-list">
                {github.pullRequests.map((pullRequest) => (
                  <li>
                    <a
                      href={pullRequest.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {pullRequest.title}
                      <span class="sr-only">
                        {` in ${pullRequest.repositoryName}`}
                      </span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </section>

      <section class="projects section-block" aria-labelledby="projects-title">
        <h2 id="projects-title">Projects</h2>
        {
          github.projects.length > 0 ? (
            <ol class="project-list">
              {github.projects.map((project) => (
                <li>
                  <div class="project-line">
                    <a
                      href={project.homepageUrl ?? project.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {project.displayName} <span aria-hidden="true">↗</span>
                    </a>
                    <span class="project-meta">
                      {project.primaryLanguage ?? "Open source"}
                      {project.stars > 0 && ` · ${project.stars}★`}
                    </span>
                  </div>
                  <p>{project.description}</p>
                </li>
              ))}
            </ol>
          ) : (
            <p class="empty-state">
              Project details are being refreshed. View the work directly on
              <a href={githubUrl}>GitHub</a>.
            </p>
          )
        }
      </section>

      <section class="writings section-block" aria-labelledby="writings-title">
        <div class="section-heading-row">
          <h2 id="writings-title">Writings</h2>
          {
            writings.source === "live" && (
              <span class="source-label">Latest</span>
            )
          }
        </div>
        {
          writings.articles.length > 0 ? (
            <ol class="writing-list">
              {writings.articles.map((article) => (
                <li>
                  <time datetime={article.publishedAt}>
                    {articleDate.format(new Date(article.publishedAt))}
                  </time>
                  <a
                    href={article.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {article.title} <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ol>
          ) : (
            <p class="empty-state">
              New writing is on the way. In the meantime, follow my work on
              <a href={githubUrl}>GitHub</a>.
            </p>
          )
        }
      </section>
    </div>

    <footer class="site-footer">
      <nav aria-label="Connect">
        <h2 class="footer-heading">Connect</h2>
        <ul class="footer-links">
          {
            siteConfig.socialLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.href.startsWith("http") ? "_blank" : undefined}
                  rel={
                    link.href.startsWith("http")
                      ? "noopener noreferrer"
                      : undefined
                  }
                >
                  <SocialIcon name={link.label} />
                  <span class="footer-label">{link.label}</span>
                  <span class="footer-arrow" aria-hidden="true">
                    ↗
                  </span>
                  {link.handle && (
                    <span class="footer-handle">({link.handle})</span>
                  )}
                </a>
              </li>
            ))
          }
          {
            siteConfig.person.resumeUrl && (
              <li>
                <a
                  href={siteConfig.person.resumeUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <SocialIcon name="Résumé" />
                  <span class="footer-label">Résumé</span>
                  <span class="footer-arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              </li>
            )
          }
        </ul>
      </nav>
      <span class="copyright">
        {`© ${new Date().getFullYear()} ${siteConfig.person.name}`}
      </span>
    </footer>
  </main>

  <script is:inline>
    ;(() => {
      const clock = document.querySelector("#india-clock")
      if (clock instanceof HTMLTimeElement) {
        const formatter = new Intl.DateTimeFormat("en-IN", {
          timeZone: clock.dataset.timeZone || "Asia/Kolkata",
          hour: "2-digit",
          minute: "2-digit",
          hour12: true,
        })

        const update = () => {
          const now = new Date()
          clock.textContent = formatter
            .format(now)
            .replace(/\b(am|pm)\b/gi, (period) => period.toUpperCase())
          clock.dateTime = now.toISOString()
        }

        update()
        window.setInterval(update, 60_000)
      }

      const weather = document.querySelector("#weather-status")
      if (!(weather instanceof HTMLElement)) return

      const latitude = Number(weather.dataset.latitude)
      const longitude = Number(weather.dataset.longitude)
      if (!Number.isFinite(latitude) || !Number.isFinite(longitude)) return

      const getWeather = (code, isDay) => {
        if (code === 0) return isDay ? ["☀️", "Clear"] : ["🌙", "Clear"]
        if (code <= 2) return ["🌤️", "Partly cloudy"]
        if (code === 3) return ["☁️", "Overcast"]
        if (code === 45 || code === 48) return ["🌫️", "Fog"]
        if (code >= 51 && code <= 57) return ["🌦️", "Drizzle"]
        if (code >= 61 && code <= 67) return ["🌧️", "Rain"]
        if (code >= 71 && code <= 77) return ["🌨️", "Snow"]
        if (code >= 80 && code <= 82) return ["🌦️", "Showers"]
        if (code >= 85 && code <= 86) return ["🌨️", "Snow showers"]
        if (code >= 95 && code <= 99) return ["⛈️", "Thunderstorm"]
        return ["🌤️", "Weather"]
      }

      const endpoint = new URL("https://api.open-meteo.com/v1/forecast")
      endpoint.search = new URLSearchParams({
        latitude: String(latitude),
        longitude: String(longitude),
        current: "temperature_2m,weather_code,is_day",
        timezone: "auto",
        forecast_days: "1",
      }).toString()

      const controller = new AbortController()
      const timeout = window.setTimeout(() => controller.abort(), 5_000)

      fetch(endpoint, { signal: controller.signal })
        .then((response) => {
          if (!response.ok) throw new Error("Weather request failed")
          return response.json()
        })
        .then((payload) => {
          const temperature = Number(payload?.current?.temperature_2m)
          const code = Number(payload?.current?.weather_code)
          const isDay = Number(payload?.current?.is_day) === 1

          if (!Number.isFinite(temperature) || !Number.isFinite(code)) {
            throw new Error("Weather response was incomplete")
          }

          const [emoji, condition] = getWeather(code, isDay)
          const icon = document.createElement("span")
          const copy = document.createElement("span")
          icon.className = "weather-icon"
          icon.ariaHidden = "true"
          icon.textContent = emoji
          copy.className = "weather-copy"
          copy.textContent = `${Math.round(temperature)}°C, ${condition}`
          const separator = document.createElement("span")
          separator.ariaHidden = "true"
          separator.textContent = ","
          weather.replaceChildren(separator, copy, icon)
          weather.ariaLabel = `${Math.round(temperature)} degrees Celsius, ${condition}; data by Open-Meteo`
        })
        .catch(() => {
          const icon = weather.querySelector(".weather-icon")
          const copy = weather.querySelector(".weather-copy")

          if (icon instanceof HTMLElement) icon.textContent = "☁️"
          if (copy instanceof HTMLElement)
            copy.textContent = "Weather unavailable"
          weather.ariaLabel = "Weather unavailable; data by Open-Meteo"
        })
        .finally(() => window.clearTimeout(timeout))
    })()
  </script>
</BaseLayout>
